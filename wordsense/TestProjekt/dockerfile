# --- Development stage -------------------------------------------------------
FROM node:20-slim

# 1. MATCH THIS TO YOUR DOCKER COMPOSE VOLUME
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies for development
RUN npm install

# Copy the rest of your project
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start SvelteKit in dev mode (watch mode)
CMD ["npm", "run", "dev", "--", "--host"]
